{
  "name": "arrow-flight-client",
  "version": "0.0.10",
  "description": "Apache Arrow Flight Client for Node.js",
  "keywords": [
    "apache-arrow",
    "arrow-flight",
    "arrow-ipc",
    "flight-rpc",
    "grpc",
    "protobuf",
    "record-batch",
    "columnar-data"
  ],
  "author": {
    "name": "Stanislav Potemkin",
    "email": "woodger@ya.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodger/arrow-flight-client.git"
  },
  "directories": {
    "doc": "docs"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/woodger/arrow-flight-client/issues"
  },
  "homepage": "https://github.com/woodger/arrow-flight-client#readme",
  "engines": {
    "node": ">=16.9.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "fwa --prune",
    "lint": "biome lint src",
    "generate:proto": "grpc_tools_node_protoc --proto_path=contracts --ts_proto_out=src/generated --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,useExactTypes=false,env=node,esModuleInterop=true contracts/Flight.proto",
    "test:pyarrow": "node --test dist/client/flight-client.pyarrow.e2e.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@grpc/grpc-js": "^1.14.4",
    "nice-grpc": "^2.1.16",
    "nice-grpc-common": "^2.0.3"
  },
  "peerDependencies": {
    "apache-arrow": "^21.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.0.1",
    "apache-arrow": "^21.1.0",
    "fwa": "^2.1.0",
    "grpc-tools": "1.13.1",
    "ts-proto": "2.10.1",
    "typescript": "7.0.2"
  }
}

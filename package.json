{
  "name": "arrow-flight-client",
  "version": "0.0.17",
  "description": "Apache Arrow Flight Client for Node.js",
  "keywords": [
    "apache-arrow",
    "arrow-flight",
    "arrow-ipc",
    "flight-rpc",
    "grpc",
    "protobuf",
    "record-batch",
    "pyarrow"
  ],
  "author": {
    "name": "Stanislav Potemkin",
    "email": "woodger@ya.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodger/arrow-flight-client.git"
  },
  "directories": {
    "doc": "docs"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/woodger/arrow-flight-client/issues"
  },
  "homepage": "https://github.com/woodger/arrow-flight-client#readme",
  "engines": {
    "node": ">=16.9.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "fwa --prune",
    "lint": "oxlint src",
    "generate:proto": "node dist/cli/index.js generate proto",
    "test:pyarrow": "node dist/cli/index.js test pyarrow"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@grpc/grpc-js": "^1.14.4",
    "nice-grpc": "^2.1.16",
    "nice-grpc-common": "^2.0.3"
  },
  "peerDependencies": {
    "apache-arrow": "^21.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "apache-arrow": "^21.1.0",
    "fwa": "^2.1.4",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "protoc": "32.1.0",
    "ts-proto": "2.12.3",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true
  }
}
